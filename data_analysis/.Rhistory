precision_var_name = PRECISION_NAME,
recall_var_name = RECALL_NAME,
my_dir_list = dir_list,
my_xlim = c(0.8, 1),
my_ylim = c(0.4, 1),
my_xlab = SIGN_SIM_NAME)
